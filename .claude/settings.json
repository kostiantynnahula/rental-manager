{
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm gen:api)",
      "Bash(pnpm --filter:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-remote:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env*)",
      "Read(./apps/api/prisma/seed-users.json)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push *:main)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git fetch *--upl*)",
      "Bash(git ls-remote *--upl*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs -r pnpm exec prettier --write --ignore-unknown"
          }
        ]
      }
    ]
  }
}
