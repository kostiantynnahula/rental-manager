{
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm gen:api)",
      "Bash(pnpm --filter:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git branch --show-current)",
      "Bash(git ls-remote --heads origin:*)",
      "Bash(git fetch origin:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env*)",
      "Read(./apps/api/prisma/seed-users.json)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push *--forc*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push * +*)",
      "Bash(git push *--al*)",
      "Bash(git push *--br*)",
      "Bash(git push *--mi*)",
      "Bash(git push *--de*)",
      "Bash(git push *--pru*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * :**)",
      "Bash(git push *--rec*)",
      "Bash(git push *--e*)",
      "Bash(git fetch *--upl*)",
      "Bash(git fetch *:**)",
      "Bash(git ls-remote *--u*)",
      "Bash(git ls-remote *--e*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs -r pnpm exec prettier --write --ignore-unknown"
          }
        ]
      }
    ]
  }
}
