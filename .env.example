# Copy to .env (never commit .env). Used by docker-compose.yml.

# Postgres
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental
# Host port; 5433 to avoid clashing with other local Postgres instances.
POSTGRES_PORT=5433

# MinIO (S3-compatible photo storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=photos
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API (apps/api reads this file via @nestjs/config)
NODE_ENV=development
PORT=3001

# Postgres from docker-compose (host port = POSTGRES_PORT)
DATABASE_URL=postgresql://rental:rental@localhost:5433/rental?schema=public

# Auth. Use a real random secret outside local dev: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
