# Copy to .env (never commit .env). Used by docker-compose.yml.

# Postgres
POSTGRES_USER=rental
POSTGRES_PASSWORD=rental
POSTGRES_DB=rental
# Host port; 5433 to avoid clashing with other local Postgres instances.
POSTGRES_PORT=5433

# MinIO (S3-compatible photo storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=photos
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# API (apps/api reads this file via @nestjs/config)
NODE_ENV=development
PORT=3001

# Postgres from docker-compose (host port = POSTGRES_PORT)
DATABASE_URL=postgresql://rental:rental@localhost:5433/rental?schema=public

# Auth. Use a real random secret outside local dev: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Web (apps/web): where the Next.js /api/* proxy forwards to (server-side only, not exposed to the browser).
API_INTERNAL_URL=http://localhost:3001

# Photo storage (S3 API; MinIO from docker-compose in dev). For real S3: drop S3_ENDPOINT,
# set S3_FORCE_PATH_STYLE=false and use IAM keys. dotenv doesn't expand ${MINIO_*}, so repeat them.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
# Upload limits (POST /apartments/:id/photos)
PHOTO_MAX_FILES=10
PHOTO_MAX_FILE_SIZE_MB=15

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

API_BASE_URL=http://localhost:3001/api
API_KEY=rm_585dde59_WimjLxlJ2n1O9eyCJ7fojBwV7gb8zqQcB_WOsd9_590

# Photo extraction (worker)
ANTHROPIC_API_KEY=sk-ant-usr-********
EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-haiku-5-5
EXTRACTION_EFFORT=medium

# Telegram bot for notifications (optional)
TELEGRAM_BOT_TOKEN=9023024425:AAEbIMS_******
TELEGRAM_ALLOWED_USER_IDS=387408703