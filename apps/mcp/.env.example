# Optional override for the MCP server only. Without this file the server reads the repo-root .env
# (API_BASE_URL, MCP_API_KEY, MCP_LOG_FILE); values set by the client's `env` block win over both.
API_BASE_URL=http://localhost:3001/api
# `pnpm --filter api apikey:create --service mcp ...` (see README → MCP server)
MCP_API_KEY=
# Also append the log lines here (stderr always), e.g. for `tail -f`
# MCP_LOG_FILE=logs/mcp.log
