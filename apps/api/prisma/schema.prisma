// Prisma 7: the connection URL lives in prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // apps/api uses `module: nodenext`, which requires .js extensions in relative imports.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserKind {
  HUMAN
  SERVICE
}

model User {
  id                  String      @id @default(uuid()) @db.Uuid
  // Always lowercase + trimmed (normalizeEmail); enforced by a CHECK constraint in the migration.
  // SERVICE users use the reserved `.invalid` TLD, e.g. `worker@service.invalid`.
  email               String      @unique
  // HUMAN users log in with a password; SERVICE users (worker, bots) only with API keys.
  kind                UserKind    @default(HUMAN)
  // NULL exactly for SERVICE users (CHECK users_password_matches_kind in the migration).
  passwordHash        String?
  name                String?
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  sessions            Session[]
  createdReadings     Reading[]   @relation("ReadingCreatedBy")
  confirmedReadings   Reading[]   @relation("ReadingConfirmedBy")
  uploadedPhotos      Photo[]
  issuedStatements    Statement[] @relation("StatementIssuedBy")
  cancelledStatements Statement[] @relation("StatementCancelledBy")
  apiKeys             ApiKey[]

  @@map("users")
}

// Long-lived key of a SERVICE user. Revoked via revokedAt, never deleted; the key itself is never stored or logged.
model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  name       String
  // Public, non-secret start of the key: shown in lists, identifies a key in logs.
  prefix     String    @unique
  // SHA-256 of the full key (random secret → a fast hash is fine, as for refresh tokens).
  keyHash    String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

// One row per refresh token. Rotation revokes the row and links it to its successor.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the opaque refresh token; the token itself is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique @db.Uuid
  replacedBy   Session?  @relation("SessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     Session?  @relation("SessionRotation")
  userAgent    String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// Archived via isActive, never deleted (leases reference it with onDelete: Restrict).
model Apartment {
  id         String            @id @default(uuid()) @db.Uuid
  // Short label, e.g. "Shevchenka 12/5".
  name       String            @unique
  address    String
  notes      String?
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  leases     Lease[]
  meters     Meter[]
  photos     Photo[]
  tariffs    ApartmentTariff[]
  statements Statement[]

  @@map("apartments")
}

model Tenant {
  id        String        @id @default(uuid()) @db.Uuid
  fullName  String
  phone     String
  email     String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  leases    LeaseTenant[]

  @@map("tenants")
}

// Raw-SQL constraints in migration add_apartments_tenants_leases:
//   leases_dates_check (endDate >= startDate), leases_no_overlap (EXCLUDE, per apartment),
//   lease_tenants_one_primary (partial unique: at most one PRIMARY per lease).
model Lease {
  id          String        @id @default(uuid()) @db.Uuid
  apartmentId String        @db.Uuid
  // Restrict: an apartment with lease history can't be deleted (archive it instead).
  apartment   Apartment     @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  startDate   DateTime      @db.Date
  // Inclusive last day; null = open-ended.
  endDate     DateTime?     @db.Date
  // Integer kopiyky, UAH.
  monthlyRent Int
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenants     LeaseTenant[]
  statements  Statement[]

  @@index([apartmentId])
  @@map("leases")
}

enum LeaseTenantRole {
  PRIMARY
  CONTACT

  @@map("lease_tenant_role")
}

model LeaseTenant {
  leaseId  String          @db.Uuid
  // Cascade: the links belong to the lease (deleting a lease is a deliberate act).
  lease    Lease           @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenantId String          @db.Uuid
  // Restrict: a tenant with lease history can't be deleted.
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role     LeaseTenantRole

  // The PK (leaseId, tenantId) already serves as the index for leaseId (leading column).
  @@id([leaseId, tenantId])
  @@index([tenantId])
  @@map("lease_tenants")
}

enum UtilityType {
  ELECTRICITY
  COLD_WATER
  HOT_WATER
  GAS

  @@map("utility_type")
}

// SINGLE → one TOTAL register; DAY_NIGHT → DAY + NIGHT registers.
enum ZoneScheme {
  SINGLE
  DAY_NIGHT

  @@map("zone_scheme")
}

enum Zone {
  TOTAL
  DAY
  NIGHT

  @@map("zone")
}

// INITIAL starts a meter (installation), FINAL ends it (removal), REGULAR = monthly.
enum ReadingKind {
  REGULAR
  INITIAL
  FINAL

  @@map("reading_kind")
}

// Only CONFIRMED readings are ever used; corrections = cancel + new reading.
enum ReadingStatus {
  DRAFT
  CONFIRMED
  CANCELLED

  @@map("reading_status")
}

enum ReadingSource {
  MANUAL
  PHOTO

  @@map("reading_source")
}

// Raw-SQL constraint in migration add_meters_readings: meters_removed_after_installed.
model Meter {
  id           String      @id @default(uuid()) @db.Uuid
  apartmentId  String      @db.Uuid
  // Restrict: meter history must stay; an apartment is archived, never deleted.
  apartment    Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  utility      UtilityType
  zoneScheme   ZoneScheme
  // Several meters of one utility are allowed, e.g. "kitchen" / "bathroom".
  label        String?
  serialNumber String?
  installedAt  DateTime    @db.Date
  removedAt    DateTime?   @db.Date
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  readings     Reading[]

  @@index([apartmentId])
  @@map("meters")
}

// Raw-SQL constraints in migration add_meters_readings: readings_period_first_of_month,
// readings_confirmed_has_confirmer, readings_one_confirmed_{regular_per_period,initial,final}.
// View reading_consumption (migration add_reading_consumption_view, + previousPeriod in
// reading_consumption_previous_period): per-value consumption of CONFIRMED readings; read with $queryRaw (no Prisma
// model).
model Reading {
  id            String         @id @default(uuid()) @db.Uuid
  meterId       String         @db.Uuid
  // Restrict: readings are history; a meter is removed (removedAt), never deleted with readings.
  meter         Meter          @relation(fields: [meterId], references: [id], onDelete: Restrict)
  // The month the reading is for, always its 1st day.
  period        DateTime       @db.Date
  // When the meter was actually read.
  readingDate   DateTime       @db.Date
  kind          ReadingKind
  status        ReadingStatus  @default(DRAFT)
  note          String?
  createdById   String         @db.Uuid
  createdBy     User           @relation("ReadingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  confirmedAt   DateTime?
  confirmedById String?        @db.Uuid
  confirmedBy   User?          @relation("ReadingConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  // Source and photo live on each value: one photo shows one register, so a DAY_NIGHT reading may
  // come from two photos, and a DRAFT may hold only some of the meter's zones.
  values        ReadingValue[]

  // Also serves as the meterId FK index (leading column), so no separate @@index([meterId]).
  @@index([meterId, period])
  @@index([createdById])
  @@index([confirmedById])
  @@map("readings")
}

// A meter photo as uploaded: the original object is stored byte-for-byte and never changed.
// The worker's parse job for a photo: PENDING (queued / running / retrying) → PARSED (drafts created),
// NOT_MATCHED (nothing could be matched to a meter) or FAILED (gave up).
enum PhotoParseStatus {
  PENDING
  PARSED
  NOT_MATCHED
  FAILED

  @@map("photo_parse_status")
}

model Photo {
  id               String            @id @default(uuid()) @db.Uuid
  apartmentId      String            @db.Uuid
  apartment        Apartment         @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  // photos/YYYY/MM/<id>.<ext> — never derived from the original filename.
  storageKey       String            @unique
  // thumbnails/YYYY/MM/<id>.webp
  thumbnailKey     String            @unique
  // Detected from the file content, not from the client's header.
  mimeType         String
  size             Int
  // Lowercase hex; dedup key.
  sha256           String            @unique
  width            Int
  height           Int
  originalFilename String?
  uploadedById     String            @db.Uuid
  uploadedBy       User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  // Set by the API on upload (PENDING) and by the worker when its job ends; null = never queued (older photos).
  parseStatus      PhotoParseStatus?
  // Why nothing was matched, or the job's error (the worker's text).
  parseNote        String?
  readingValues    ReadingValue[]

  @@index([apartmentId, createdAt])
  @@index([uploadedById])
  @@map("photos")
}

// Raw-SQL constraint in migration add_meters_readings: reading_values_non_negative.
model ReadingValue {
  readingId String        @db.Uuid
  // Cascade: values are part of their reading (readings are cancelled, not deleted, anyway).
  reading   Reading       @relation(fields: [readingId], references: [id], onDelete: Cascade)
  zone      Zone
  // Prisma returns Prisma.Decimal (decimal.js): never convert to number for calculations.
  value     Decimal       @db.Decimal(12, 3)
  // PHOTO exactly when photoId is set (CHECK reading_values_source_matches_photo).
  source    ReadingSource @default(MANUAL)
  // The photo this value was read from. One photo may back several values (e.g. cold + hot water in
  // one shot). Restrict: a photo is evidence, keep it.
  photoId   String?       @db.Uuid
  photo     Photo?        @relation(fields: [photoId], references: [id], onDelete: Restrict)

  // The PK (readingId, zone) also serves as the readingId FK index.
  @@id([readingId, zone])
  @@index([photoId])
  @@map("reading_values")
}

// METERED = price per unit of consumption; FIXED = price per month (no meter); MANUAL = no price, the amount is
// entered per statement (e.g. a share of the building water bill).
enum TariffKind {
  METERED
  FIXED
  MANUAL

  @@map("tariff_kind")
}

// A bill line from a shared catalog: meter tariffs and fixed fees alike. Prices depending on the
// district get their own tariff (e.g. "Waste removal (Sykhiv)"). Archived via isActive.
// Raw-SQL constraint tariffs_utilities_match_kind (migration add_tariffs, MANUAL added in manual_tariff_checks).
// A MANUAL tariff has no prices (checked by the service).
model Tariff {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @unique
  kind           TariffKind
  // METERED: the utilities whose consumption is billed, ≥ 1 (e.g. drainage = COLD_WATER + HOT_WATER).
  // FIXED, MANUAL: empty.
  utilities      UtilityType[]
  isActive       Boolean           @default(true)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  prices         TariffPrice[]
  apartments     ApartmentTariff[]
  statementLines StatementLine[]

  @@map("tariffs")
}

// Price history of a tariff. The price for a period = the latest effectiveFrom <= period for the
// zone, falling back to TOTAL (so a two-zone meter only needs an extra NIGHT price).
// DAY/NIGHT prices only for METERED electricity tariffs — checked by the service.
// Raw-SQL constraints in migration add_tariffs: tariff_prices_effective_first_of_month,
// tariff_prices_non_negative.
model TariffPrice {
  id            String   @id @default(uuid()) @db.Uuid
  tariffId      String   @db.Uuid
  // Cascade: prices are part of their tariff (a used tariff is archived, never deleted).
  tariff        Tariff   @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  // 1st day of the first month the price applies to (like Reading.period).
  effectiveFrom DateTime @db.Date
  zone          Zone     @default(TOTAL)
  // UAH: per unit for METERED, per month for FIXED. Line totals are rounded to kopiyky by billing.
  price         Decimal  @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  // Also serves as the tariffId FK index (leading column).
  @@unique([tariffId, effectiveFrom, zone])
  @@map("tariff_prices")
}

// Which tariffs an apartment is billed for, by month.
// Raw-SQL constraints in migration add_tariffs: apartment_tariffs_active_from_first_of_month,
// apartment_tariffs_active_to_first_of_month, apartment_tariffs_dates_check, apartment_tariffs_no_overlap.
model ApartmentTariff {
  id          String    @id @default(uuid()) @db.Uuid
  apartmentId String    @db.Uuid
  apartment   Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  tariffId    String    @db.Uuid
  tariff      Tariff    @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  // 1st day of the first billed month.
  activeFrom  DateTime  @db.Date
  // 1st day of the last billed month (inclusive); null = ongoing.
  activeTo    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Also serves as the apartmentId FK index (leading column).
  @@index([apartmentId, tariffId])
  @@index([tariffId])
  @@map("apartment_tariffs")
}

enum StatementStatus {
  ISSUED
  CANCELLED

  @@map("statement_status")
}

enum StatementLineType {
  RENT
  FIXED
  METERED
  MANUAL

  @@map("statement_line_type")
}

// A frozen monthly bill: lines, prices and warnings as of issue time; later tariff or reading changes don't touch it.
// Corrected by cancelling and issuing again.
// Raw-SQL constraints in migration add_statements: statements_period_first_of_month,
// statements_one_issued_per_period (partial unique), statements_cancel_consistency, statements_total_non_negative.
model Statement {
  id            String          @id @default(uuid()) @db.Uuid
  apartmentId   String          @db.Uuid
  apartment     Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  // The month billed, always its 1st day.
  period        DateTime        @db.Date
  // The lease used for the rent line; null without one.
  leaseId       String?         @db.Uuid
  lease         Lease?          @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  status        StatementStatus @default(ISSUED)
  // Integer kopiyky: the sum of the line amounts.
  totalAmount   Int
  // Calculator warnings at issue time; empty array if none.
  warnings      Json
  issuedAt      DateTime        @default(now())
  issuedById    String          @db.Uuid
  issuedBy      User            @relation("StatementIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  cancelledAt   DateTime?
  cancelledById String?         @db.Uuid
  cancelledBy   User?           @relation("StatementCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelNote    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lines         StatementLine[]

  // Serves the list query and, as the leading column, the apartmentId FK.
  @@index([apartmentId, period(sort: Desc)])
  @@index([leaseId])
  @@index([issuedById])
  @@index([cancelledById])
  @@map("statements")
}

// Raw-SQL constraints in migration add_statements: statement_lines_tariff_by_type (redefined in manual_tariff_checks),
// statement_lines_non_negative.
model StatementLine {
  id          String            @id @default(uuid()) @db.Uuid
  // Cascade: lines are part of their statement.
  statementId String            @db.Uuid
  statement   Statement         @relation(fields: [statementId], references: [id], onDelete: Cascade)
  // Display order from the calculator.
  position    Int
  type        StatementLineType
  // Null only for RENT.
  tariffId    String?           @db.Uuid
  tariff      Tariff?           @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  // Snapshot of the tariff name, "Оренда" for rent.
  name        String
  // Snapshot; empty for RENT and FIXED.
  utilities   UtilityType[]
  zone        Zone?
  // Null exactly for MANUAL (amount only).
  quantity    Decimal?          @db.Decimal(12, 3)
  // UAH. Null exactly for MANUAL.
  unitPrice   Decimal?          @db.Decimal(12, 4)
  // Integer kopiyky.
  amount      Int
  // METERED: [{ meterId, utility, label, serialNumber, consumption }] as of issue time.
  details     Json?

  // Also serves as the statementId FK index (leading column).
  @@unique([statementId, position])
  @@index([tariffId])
  @@map("statement_lines")
}
