  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "seed": "prisma db seed",
    "openapi:export": "nest build && node dist/openapi/export.js",
    "apikey:create": "nest build && node dist/cli/api-keys.js create",
    "apikey:list": "nest build && node dist/cli/api-keys.js list",
    "apikey:revoke": "nest build && node dist/cli/api-keys.js revoke"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@nestjs/bullmq": "^12.0.1",
